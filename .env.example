# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Command Prefix for prefix-based commands (optional, since slash commands are also enabled)
BOT_PREFIX=!

# OPTIONAL: your test server's ID (right-click server -> Copy Server ID, with Developer Mode on).
# When set, slash commands sync instantly to that server only (recommended while developing).
# When empty, commands sync globally (can take up to ~1 hour to propagate).
DEV_GUILD_ID=

# ============================================================
# Chat API (OpenAI-compatible endpoint) - REQUIRED for the bot to reply
# Works with OpenAI, OpenRouter, Groq, Together, Gemini (OpenAI-compat mode),
# and local servers (Ollama, llama.cpp, vLLM, LM Studio, ...).
# ============================================================

# Example with OpenAI:
# CHAT_API_URL=https://api.openai.com/v1/chat/completions
# CHAT_API_KEY=sk-xxxx
# CHAT_API_MODEL=gpt-4o-mini

# Example with a local Ollama server (no API key needed):
# CHAT_API_URL=http://localhost:11434/v1/chat/completions
# CHAT_API_MODEL=llama3.2

# Example with the ragita.net endpoint (streaming SSE):
# CHAT_API_URL=https://chat.ragita.net/api/chat/completions
# CHAT_API_KEY=eyJhbGciOi... (the bearer/JWT token)
# CHAT_API_MODEL=gpt-oss:20b

CHAT_API_URL=
CHAT_API_KEY=
CHAT_API_MODEL=
CHAT_API_SYSTEM_PROMPT=Kamu adalah Garapizza, AI yang santai dan asyik buat diajak ngobrol. Jawab dengan gaya santai, natural, dan hangat seperti ngobrol sama teman. Pakai bahasa yang sama dengan user. Tetap ringkas dan nggak bertele-tele.
# Max idle seconds with no data from the API before the request is cancelled.
# This is NOT a total time cap: slow/streaming responses are allowed to run as
# long as data keeps arriving (e.g. a model "thinking" for a while).
CHAT_API_TIMEOUT=120
# Conversation memory (optional tuning):
# CHAT_HISTORY_MESSAGES=20   # turns of memory kept per channel
# CHAT_HISTORY_TTL=1800      # idle seconds before the memory resets

# ============================================================
# Voice (optional) - bot speaks in voice channels
# TTS: edge-tts (free, no API key). Voice name from edge-tts --list-voices.
#      id-ID-GadisNeural = Indonesian female; id-ID-ArdiNeural = Indonesian male
# STT: faster-whisper (local, offline, no API key). Model size: tiny/base/small/medium.
# Requires ffmpeg on PATH (winget install ffmpeg).
# ============================================================
TTS_VOICE=id-ID-GadisNeural
STT_MODEL=small
# Language hint for transcription (leave empty for auto-detect):
STT_LANGUAGE=id
