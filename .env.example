# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Command Prefix for prefix-based commands (optional, since slash commands are also enabled)
BOT_PREFIX=!

# ============================================================
# Chat API (OpenAI-compatible endpoint) - OPTIONAL
# Leave CHAT_API_URL empty to keep using the built-in rule-based replies.
# Works with OpenAI, OpenRouter, Groq, Together, Gemini (OpenAI-compat mode),
# and local servers (Ollama, llama.cpp, vLLM, LM Studio, ...).
# ============================================================

# Example with OpenAI:
# CHAT_API_URL=https://api.openai.com/v1/chat/completions
# CHAT_API_KEY=sk-xxxx
# CHAT_API_MODEL=gpt-4o-mini

# Example with a local Ollama server (no API key needed):
# CHAT_API_URL=http://localhost:11434/v1/chat/completions
# CHAT_API_MODEL=llama3.2

# Example with the ragita.net endpoint (streaming SSE):
# CHAT_API_URL=https://chat.ragita.net/api/chat/completions
# CHAT_API_KEY=eyJhbGciOi... (the bearer/JWT token)
# CHAT_API_MODEL=gpt-oss:20b

CHAT_API_URL=
CHAT_API_KEY=
CHAT_API_MODEL=
CHAT_API_SYSTEM_PROMPT=You are a friendly Discord chatbot. Keep replies concise, conversational, and in the same language the user uses.
CHAT_API_TIMEOUT=30
